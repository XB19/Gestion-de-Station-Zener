{
  "name": "zener-station-manager",
  "private": true,
  "version": "1.0.0",
  "description": "ZENER Station Manager - application desktop de gestion des stations",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n vite,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && node electron/launch.cjs --dev\"",
    "electron": "vite build && node electron/launch.cjs",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "tg.zener.stationmanager",
    "productName": "ZENER Station Manager",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
