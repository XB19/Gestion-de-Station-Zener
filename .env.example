# Variables du backend (copier en .env ou les définir dans l'environnement)

# Base PostgreSQL
DB_URL=jdbc:postgresql://localhost:5434/zener_station
DB_USER=zener
DB_PASSWORD=zener

# Port de l'API
SERVER_PORT=8090

# Jetons de connexion : 32 caractères minimum, obligatoire en production
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-ou-plus
JWT_TTL_HOURS=12

# Origines autorisées (Vite en développement, « null » = Electron en file://)
CORS_ORIGINS=http://localhost:5173,null

# Dossier des fichiers envoyés (photos des employés)
UPLOAD_DIR=./uploads

# Fuseau de l'application
APP_TIMEZONE=Africa/Lome

# Emails : sans MAIL_HOST, ils restent dans la file (GET /api/settings/emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=station-manager@zener.tg

# Données de démonstration (base vide uniquement)
DEMO_DATA=false
